{
  "name": "padel-cilento",
  "version": "1.0.0",
  "private": true,
  "description": "Trova e organizza partite di Padel nel Cilento",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel build --prod && vercel deploy --prebuilt --prod",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/styles.css --minify",
    "test": "node test/db.test.mjs && node test/app.test.mjs",
    "test:db": "node test/db.test.mjs",
    "test:app": "node test/app.test.mjs",
    "db:baseline": "node scripts/db.mjs baseline",
    "db:push": "node scripts/db.mjs push",
    "db:status": "node scripts/db.mjs status",
    "db:verify": "node scripts/verifica.mjs",
    "dati:demo": "node scripts/dati-demo.mjs",
    "spot": "node scripts/spot.mjs",
    "marchio": "node scripts/marchio.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "pg": "^8.22.0",
    "playwright": "^1.62.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.19",
    "vercel": "^48.0.0"
  }
}
